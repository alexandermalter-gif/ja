<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. The API key (DataStore file "secrets") never leaves the device.
     The step sensor baseline is device specific and must not be restored on another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/secrets.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="step_sensor.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/secrets.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="step_sensor.xml" />
    </device-transfer>
</data-extraction-rules>
